{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "gitRepository": {
    "type": "git",
    "repo": "finance-flow-ai"
  },
  "functions": {
    "app/page.tsx": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ]
}
